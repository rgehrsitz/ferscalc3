<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FERS Monte Carlo – Scenario Comparison</title>
    <style>
        :root {
            --bg: #0f172a;
            --panel: #111c3a;
            --accent: #38bdf8;
            --accent-2: #f97316;
            --text: #f8fafc;
            --muted: #94a3b8;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            background: radial-gradient(circle at top, rgba(56,189,248,0.14), rgba(15,23,42,0.95));
            font-family: "Space Grotesk", "Segoe UI", system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
            color: var(--text);
            min-height: 100vh;
            padding: 40px 20px;
        }
        .shell {
            max-width: 1200px;
            margin: 0 auto;
        }
        header {
            text-align: center;
            margin-bottom: 30px;
        }
        header h1 {
            font-size: 2.5rem;
            letter-spacing: 0.04em;
            margin: 0 0 10px;
        }
        header p {
            color: var(--muted);
            margin: 0;
        }
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 18px;
            margin-bottom: 30px;
        }
        .card {
            background: rgba(17,28,58,0.85);
            padding: 18px 20px;
            border-radius: 16px;
            border: 1px solid rgba(148,163,184,0.2);
            box-shadow: 0 15px 40px rgba(15,23,42,0.35);
        }
        .card h3 {
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 0.2em;
            color: var(--muted);
            margin: 0 0 6px;
        }
        .card strong {
            font-size: 1.9rem;
            font-weight: 600;
            color: var(--accent);
        }
        .table-wrap {
            overflow-x: auto;
            background: rgba(15,23,42,0.8);
            border-radius: 20px;
            border: 1px solid rgba(148,163,184,0.16);
            box-shadow: 0 20px 40px rgba(15,23,42,0.4);
        }
        table {
            border-collapse: collapse;
            width: 100%;
            min-width: 900px;
        }
        th, td {
            padding: 16px 18px;
            text-align: left;
            border-bottom: 1px solid rgba(148,163,184,0.18);
        }
        th {
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.18em;
            color: var(--muted);
        }
        td {
            font-size: 1rem;
            color: #e2e8f0;
        }
        tbody tr:hover {
            background: rgba(56,189,248,0.07);
        }
        .scenario-name {
            font-size: 1.2rem;
            font-weight: 600;
            color: var(--accent);
        }
        .scenario-desc {
            display: block;
            color: var(--muted);
            margin-top: 4px;
            font-size: 0.9rem;
        }
        footer {
            margin-top: 35px;
            text-align: center;
            color: var(--muted);
            font-size: 0.9rem;
        }
        @media (max-width: 640px) {
            header h1 { font-size: 2rem; }
            .card strong { font-size: 1.5rem; }
        }
    </style>
</head>
<body>
    <div class="shell">
        <header>
            <h1>FERS Monte Carlo &mdash; Scenario Comparison</h1>
            <p>Generated {{ .GeneratedAt }}</p>
        </header>

        <div class="grid">
            <div class="card">
                <h3>Total Scenarios</h3>
                <strong>{{ .ScenarioCount }}</strong>
            </div>
            {{ if gt .ScenarioCount 0 }}
            <div class="card">
                <h3>Best Success Rate</h3>
                <strong>{{ .BestSuccessRate }}</strong>
            </div>
            <div class="card">
                <h3>Top Median Income</h3>
                <strong>{{ .BestMedianIncome }}</strong>
            </div>
            {{ end }}
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Scenario</th>
                        <th>Success Rate</th>
                        <th>Median Net Income</th>
                        <th>Median Final TSP</th>
                        <th>TSP Depletion Rate</th>
                        <th>Income Volatility</th>
                        <th>Best Case Net</th>
                        <th>Worst Case Net</th>
                    </tr>
                </thead>
                <tbody>
                    {{ if .ScenarioRows }}
                        {{ range .ScenarioRows }}
                        <tr>
                            <td>
                                <span class="scenario-name">{{ .Name }}</span>
                                <span class="scenario-desc">{{ .Description }}</span>
                            </td>
                            <td>{{ .SuccessRate }}</td>
                            <td>{{ .MedianNetIncome }}</td>
                            <td>{{ .MedianFinalTSP }}</td>
                            <td>{{ .TSPDepletionRate }}</td>
                            <td>{{ .IncomeVolatility }}</td>
                            <td>{{ .BestCaseNetIncome }}</td>
                            <td>{{ .WorstCaseNetIncome }}</td>
                        </tr>
                        {{ end }}
                    {{ else }}
                        <tr>
                            <td colspan="8">No scenarios were executed for this batch.</td>
                        </tr>
                    {{ end }}
                </tbody>
            </table>
        </div>

        <footer>
            Stress-testing scenarios modeled with historical conditions, inflation, COLA, and FEHB volatility.
        </footer>
    </div>
</body>
</html>
